        +draw_action_label(frame, mask, situation, frame_width, frame_height) np.ndarray
        +extract_action_and_state(situation) Tuple[str, str]
    }
    
    class MultiObjectDetector {
        <<module functions>>
        +detect_hands_and_object(video_path, object_prompt, predictor, max_frames) Dict
